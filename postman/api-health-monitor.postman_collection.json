{
  "info": {
    "name": "API Health Monitor",
    "description": "Collection for testing API Health Monitor endpoints (Ballerina service on localhost:9090)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090"
    }
  ],
  "item": [
    {
      "name": "Root",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains welcome message', function () {",
                  "    pm.expect(pm.response.text()).to.include('Welcome to API Health Aggregator');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"password\": \"TestPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has userId', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('userId');",
                  "    pm.environment.set('userId', json.userId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["user", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has jwtToken', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('jwtToken');",
                  "    pm.expect(json.jwtToken).to.not.be.null;",
                  "    pm.environment.set('jwtToken', json.jwtToken);",
                  "    pm.environment.set('userId', json.userId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/user/update",
              "host": ["{{baseUrl}}"],
              "path": ["user", "update"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated User\",\n  \"email\": \"updated@example.com\",\n  \"phoneNumber\": \"+9876543210\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has updated fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.equal('Updated User');",
                  "    pm.expect(json.email).to.equal('updated@example.com');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/user/password",
              "host": ["{{baseUrl}}"],
              "path": ["user", "password"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPass456!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/user/delete",
              "host": ["{{baseUrl}}"],
              "path": ["user", "delete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Success message', function () {",
                  "    pm.expect(pm.response.text()).to.include('User deleted successfully');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "API Management",
      "item": [
        {
          "name": "Create API",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": ["{{baseUrl}}"],
              "path": ["api"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test API\",\n  \"apiURL\": \"https://jsonplaceholder.typicode.com/posts\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has apiId', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('apiId');",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('apiURL');",
                  "    pm.expect(json).to.have.property('createdTime');",
                  "    pm.environment.set('apiId', json.apiId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All APIs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": ["{{baseUrl}}"],
              "path": ["api"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get API by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/{{apiId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has correct apiId', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.apiId).to.equal(pm.environment.get('apiId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update API",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/{{apiId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiId}}"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Test API\",\n  \"apiURL\": \"https://jsonplaceholder.typicode.com/users\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has updated fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.equal('Updated Test API');",
                  "    pm.expect(json.apiURL).to.equal('https://jsonplaceholder.typicode.com/users');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete API",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/{{apiId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Success message', function () {",
                  "    pm.expect(pm.response.text()).to.include('API deleted successfully');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
